NODE_ENV=development
PORT=5000

# Supabase PostgreSQL connection
DATABASE_URL=postgresql://postgres:change-me@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_HOST=db.<project-ref>.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=change-me
SUPABASE_DB_NAME=postgres
DB_SSL=true

# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
COOKIE_SECRET=change-me
COOKIE_SECURE=false
